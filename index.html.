<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0E2A3F;
    --navy-deep:#081925;
    --paper:#EEF2F0;
    --paper-2:#E4EAE7;
    --ink:#10202B;
    --steel:#5B6B72;
    --teal:#2BB8A6;
    --teal-deep:#0E6E62;
    --amber:#E8871E;
    --cloud:#F5F8F7;
    --line-light:rgba(16,32,43,0.14);
    --line-dark:rgba(245,248,247,0.18);
    --display:'Space Grotesk',sans-serif;
    --body:'IBM Plex Sans',sans-serif;
    --mono:'IBM Plex Mono',monospace;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important;}
  }
  body{
    margin:0;
    font-family:var(--body);
    color:var(--ink);
    background:var(--paper);
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{font-family:var(--display); margin:0; font-weight:600; letter-spacing:-0.01em;}
  p{margin:0;}
  a{color:inherit;}
  .wrap{max-width:1120px; margin:0 auto; padding:0 32px;}
  @media (max-width:640px){.wrap{padding:0 20px;}}

  /* ---------- nav ---------- */
  header.site{
    position:sticky; top:0; z-index:50;
    background:rgba(238,242,240,0.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line-light);
  }
  .nav-row{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 0;
  }
  .brand{display:flex; align-items:center; gap:10px; text-decoration:none;}
  .brand svg{width:26px; height:26px; display:block;}
  .brand span{font-family:var(--display); font-weight:600; font-size:1.05rem; color:var(--ink);}
  nav.links{display:flex; align-items:center; gap:28px;}
  nav.links a{font-size:0.94rem; text-decoration:none; color:var(--ink); border-bottom:1px solid transparent;}
  nav.links a:hover{border-bottom-color:var(--ink);}
  .nav-cta{
    font-size:0.9rem; font-weight:600; text-decoration:none;
    background:var(--amber); color:var(--ink);
    padding:9px 16px; border:1px solid var(--ink);
  }
  .nav-cta:hover{background:#f0983b;}
  .burger{display:none; background:none; border:1px solid var(--ink); width:38px; height:34px; cursor:pointer;}
  .burger span{display:block; width:16px; height:2px; background:var(--ink); margin:3px auto;}
  @media (max-width:820px){
    nav.links{
      position:absolute; left:0; right:0; top:100%;
      background:var(--paper); border-bottom:1px solid var(--line-light);
      flex-direction:column; align-items:flex-start; gap:0;
      padding:6px 20px 18px; display:none;
    }
    nav.links.open{display:flex;}
    nav.links a{padding:10px 0; width:100%; border-bottom:1px solid var(--line-light);}
    .nav-cta{margin-top:10px;}
    .burger{display:block;}
  }

  /* ---------- hero ---------- */
  section.hero{
    background:var(--navy);
    color:var(--cloud);
    position:relative;
    overflow:hidden;
    background-image:
      linear-gradient(var(--line-dark) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-dark) 1px, transparent 1px);
    background-size:38px 38px;
    background-position:center top;
  }
  section.hero::before{
    content:"";
    position:absolute; inset:0;
    background:radial-gradient(ellipse at 20% 0%, rgba(43,184,166,0.18), transparent 55%);
    pointer-events:none;
  }
  .hero-inner{
    position:relative;
    display:grid; grid-template-columns:1.05fr 0.95fr; gap:48px;
    align-items:center;
    padding:76px 0 0;
  }
  @media (max-width:900px){
    .hero-inner{grid-template-columns:1fr; padding-top:52px;}
  }
  .hero-loc{
    font-family:var(--mono); font-size:0.75rem; letter-spacing:0.06em;
    text-transform:uppercase; color:var(--teal); margin-bottom:18px; display:block;
  }
  .hero-copy h1{
    font-size:clamp(2.1rem, 4.2vw, 3.15rem);
    line-height:1.08;
    color:var(--cloud);
    max-width:14ch;
  }
  .hero-copy p.sub{
    margin-top:22px; max-width:46ch; font-size:1.08rem; color:#C9D8D5;
  }
  .hero-actions{display:flex; gap:14px; margin-top:32px; flex-wrap:wrap;}
  .btn{
    font-family:var(--body); font-weight:600; font-size:0.95rem;
    padding:13px 22px; text-decoration:none; display:inline-block;
    border:1px solid transparent; cursor:pointer;
  }
  .btn-primary{background:var(--amber); color:var(--ink); border-color:var(--amber);}
  .btn-primary:hover{background:#f0983b;}
  .btn-outline{background:transparent; color:var(--cloud); border-color:var(--line-dark);}
  .btn-outline:hover{border-color:var(--cloud);}
  .btn-solid-ink{background:var(--ink); color:var(--cloud); border-color:var(--ink);}
  .btn-solid-ink:hover{background:#1c3346;}

  .titleblock{
    margin-top:56px; border-top:1px solid var(--line-dark);
    display:grid; grid-template-columns:repeat(4,1fr);
  }
  .titleblock div{
    padding:14px 18px 20px; border-right:1px solid var(--line-dark);
  }
  .titleblock div:last-child{border-right:none;}
  .titleblock .k{
    display:block; font-family:var(--mono); font-size:0.66rem;
    letter-spacing:0.08em; text-transform:uppercase; color:var(--teal); margin-bottom:6px;
  }
  .titleblock .v{font-size:0.88rem; color:var(--cloud);}
  @media (max-width:640px){
    .titleblock{grid-template-columns:repeat(2,1fr);}
    .titleblock div{border-bottom:1px solid var(--line-dark);}
  }

  /* hero graphic */
  .hero-graphic{opacity:0; transform:translateY(10px); animation:riseIn 0.9s ease-out 0.15s forwards;}
  @keyframes riseIn{to{opacity:1; transform:translateY(0);}}
  .hero-graphic svg{width:100%; height:auto; display:block;}
  .gap-pulse{animation:pulseGlow 2.4s ease-in-out 1.1s infinite;}
  @keyframes pulseGlow{
    0%,100%{opacity:0.55;}
    50%{opacity:1;}
  }

  /* ---------- sections generic ---------- */
  section{padding:88px 0;}
  section.on-navy{background:var(--navy); color:var(--cloud);}
  h2{font-size:clamp(1.6rem,2.6vw,2.15rem); max-width:20ch;}
  .lede{font-size:1.05rem; color:var(--steel); max-width:56ch; margin-top:16px;}
  section.on-navy .lede{color:#C9D8D5;}

  /* ---------- problem ---------- */
  .problem-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:0;
    margin-top:48px; border:1px solid var(--line-light);
  }
  @media (max-width:760px){.problem-grid{grid-template-columns:1fr;}}
  .problem-panel{padding:32px 30px; border-right:1px solid var(--line-light);}
  .problem-panel:last-child{border-right:none;}
  @media (max-width:760px){.problem-panel{border-right:none; border-bottom:1px solid var(--line-light);}}
  .problem-panel .tag{
    font-family:var(--mono); font-size:0.72rem; letter-spacing:0.06em;
    text-transform:uppercase; padding:4px 9px; display:inline-block;
  }
  .tag.scheduled{background:var(--teal-deep); color:var(--cloud);}
  .tag.built{background:var(--amber); color:var(--ink);}
  .problem-panel ul{margin:20px 0 0; padding:0; list-style:none;}
  .problem-panel li{
    padding:10px 0; border-top:1px solid var(--line-light);
    font-size:0.96rem; display:flex; justify-content:space-between; gap:12px;
  }
  .problem-panel li:first-of-type{border-top:none;}
  .problem-panel li span.d{font-family:var(--mono); color:var(--steel); font-size:0.85rem; white-space:nowrap;}

  .problem-note{margin-top:36px; max-width:64ch; font-size:1.02rem; color:var(--ink);}

  /* ---------- how it works ---------- */
  .steps{
    display:grid; grid-template-columns:repeat(3,1fr); gap:0;
    margin-top:52px; border-top:1px solid var(--line-dark);
  }
  @media (max-width:760px){.steps{grid-template-columns:1fr;}}
  .step{padding:30px 28px 0; border-right:1px solid var(--line-dark);}
  .step:last-child{border-right:none;}
  @media (max-width:760px){.step{border-right:none; padding-bottom:28px; border-bottom:1px solid var(--line-dark);}}
  .step .num{font-family:var(--mono); font-size:0.95rem; color:var(--teal);}
  .step h3{margin-top:14px; font-size:1.18rem; color:var(--cloud);}
  .step p{margin-top:10px; color:#C9D8D5; font-size:0.96rem; max-width:32ch;}

  /* ---------- positioning ---------- */
  .position-grid{display:grid; grid-template-columns:1.1fr 0.9fr; gap:56px; margin-top:44px; align-items:start;}
  @media (max-width:800px){.position-grid{grid-template-columns:1fr;}}
  .compare dl{margin:0; border-top:1px solid var(--line-light);}
  .compare .row{display:grid; grid-template-columns:1fr 1fr; border-bottom:1px solid var(--line-light);}
  .compare .row > div{padding:14px 16px; font-size:0.92rem;}
  .compare .row > div:first-child{border-right:1px solid var(--line-light); color:var(--steel);}
  .compare .head{font-family:var(--mono); font-size:0.7rem; letter-spacing:0.06em; text-transform:uppercase; color:var(--steel); padding-bottom:8px;}
  .compare .headrow{display:grid; grid-template-columns:1fr 1fr;}
  .compare .headrow div:first-child{border-right:1px solid var(--line-light); padding-right:16px;}
  .compare .headrow div:last-child{padding-left:16px; color:var(--teal-deep) !important;}

  /* ---------- consulting ---------- */
  .consult-grid{display:grid; grid-template-columns:1.15fr 0.85fr; gap:56px; margin-top:44px; align-items:start;}
  @media (max-width:800px){.consult-grid{grid-template-columns:1fr;}}
  .service-list{list-style:none; margin:0; padding:0;}
  .service-list li{
    padding:18px 0; border-top:1px solid var(--line-light);
    display:flex; gap:14px; align-items:flex-start;
  }
  .service-list li:last-child{border-bottom:1px solid var(--line-light);}
  .service-list .mark{width:9px; height:9px; background:var(--amber); margin-top:7px; flex-shrink:0;}
  .service-list h4{font-family:var(--body); font-weight:600; font-size:1rem; margin:0 0 4px;}
  .service-list p{font-size:0.92rem; color:var(--steel);}

  /* ---------- about ---------- */
  .about-inner{display:grid; grid-template-columns:0.75fr 1.25fr; gap:56px; align-items:start;}
  @media (max-width:800px){.about-inner{grid-template-columns:1fr;}}
  .stat{border-top:1px solid var(--line-light); padding-top:14px;}
  .stat .n{font-family:var(--mono); font-size:2.1rem; color:var(--teal-deep); display:block;}
  .stat .l{font-size:0.86rem; color:var(--steel);}
  .about-inner p{max-width:60ch;}
  .about-inner p + p{margin-top:16px;}

  /* ---------- cta ---------- */
  section.cta{background:var(--navy-deep); color:var(--cloud);}
  .cta-grid{display:grid; grid-template-columns:1fr 1fr; gap:56px; margin-top:40px;}
  @media (max-width:800px){.cta-grid{grid-template-columns:1fr;}}
  .field-row{display:flex; gap:10px; margin-top:22px; flex-wrap:wrap;}
  input[type=email]{
    flex:1; min-width:200px; background:transparent; border:1px solid var(--line-dark);
    color:var(--cloud); padding:13px 14px; font-family:var(--body); font-size:0.96rem;
  }
  input[type=email]::placeholder{color:#8AA0A6;}
  input[type=email]:focus, .btn:focus-visible{outline:2px solid var(--teal); outline-offset:2px;}
  .confirm{margin-top:14px; font-size:0.9rem; color:var(--teal); display:none;}
  .confirm.show{display:block;}
  .cta-side h3{color:var(--cloud); font-size:1.05rem; font-weight:600; font-family:var(--body);}
  .cta-side p{margin-top:10px; color:#C9D8D5; font-size:0.94rem; max-width:40ch;}

  /* ---------- footer ---------- */
  footer{background:var(--navy-deep); color:#8AA0A6; border-top:1px solid var(--line-dark); padding:34px 0;}
  .foot-row{display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; font-size:0.84rem;}
  .foot-row a{text-decoration:none; color:#8AA0A6; border-bottom:1px solid transparent;}
  .foot-row a:hover{border-bottom-color:#8AA0A6;}
</style>
</head>
<body>

<header class="site">
  <div class="wrap nav-row">
    <a class="brand" href="#top">
      <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs><linearGradient id="vg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#2BB8A6"/><stop offset="1" stop-color="#0E2A3F"/>
        </linearGradient></defs>
        <path d="M6 8 L26 8 L32 40 L38 8 L58 8 L36 56 L28 56 Z" fill="url(#vg)"/>
