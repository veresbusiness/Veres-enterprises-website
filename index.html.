          <rect x="280" y="34" width="130" height="20" fill="#E8871E" opacity="0.85"/>

          <text x="0" y="112" font-family="IBM Plex Mono" font-size="11" letter-spacing="1" fill="#2BB8A6">SCHEDULE</text>
          <rect x="0" y="128" width="120" height="20" fill="#2BB8A6"/>
          <rect x="140" y="128" width="120" height="20" fill="#2BB8A6"/>
          <rect x="280" y="128" width="130" height="20" fill="#2BB8A6"/>

          <g class="gap-pulse" stroke="#F5F8F7" stroke-width="1" stroke-dasharray="3 3">
            <line x1="120" y1="44" x2="140" y2="138"/>
            <line x1="260" y1="44" x2="260" y2="138"/>
          </g>
          <g class="gap-pulse" font-family="IBM Plex Mono" font-size="10" fill="#F5F8F7">
